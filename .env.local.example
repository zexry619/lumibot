# Local-only example (DO NOT COMMIT secrets). Copy to `.env.local`.
#
# Backtesting data source selection:
# - ibkr: IBKR-only via Data Downloader
# - router: Theta + IBKR routing (default mapping)
# - JSON mapping: route by asset type

# Single-provider example:
# BACKTESTING_DATA_SOURCE=ibkr

# Multi-provider example (Theta for stock/option/index; IBKR for futures/crypto):
BACKTESTING_DATA_SOURCE='{"default":"thetadata","stock":"thetadata","option":"thetadata","index":"thetadata","future":"ibkr","crypto":"ibkr"}'

# Data Downloader connection (required for ThetaData and IBKR backtesting in this setup)
DATADOWNLOADER_BASE_URL=https://<your-downloader-host>:8080
DATADOWNLOADER_API_KEY=REPLACE_ME

# Optional: remote cache mirroring (S3)
# LUMIBOT_CACHE_BACKEND=s3
# LUMIBOT_CACHE_MODE=readwrite
# LUMIBOT_CACHE_S3_BUCKET=REPLACE_ME
# LUMIBOT_CACHE_S3_PREFIX=REPLACE_ME
# LUMIBOT_CACHE_S3_REGION=us-east-1
# LUMIBOT_CACHE_S3_VERSION=dev

# Binance USD-M Futures demo AI trader credentials.
# Keep real values in your private server environment or an untracked env file.
# BINANCE_FUTURES_DEMO_API_KEY=REPLACE_ME
# BINANCE_FUTURES_DEMO_API_SECRET=REPLACE_ME
# GEMINI_API_KEY=REPLACE_ME
#
# Optional OpenAI-compatible fallback/primary for the Binance futures AI trader.
# Use --models openai:<model>,gemini:<model> to make this primary.
# Local no-auth endpoints can omit OPENAI_COMPATIBLE_API_KEY.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8083/v1
# OPENAI_COMPATIBLE_API_KEY=REPLACE_ME
#
# Optional notifications for the Binance futures AI trader when --notify-events is set.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
# TELEGRAM_BOT_TOKEN=REPLACE_ME
# TELEGRAM_CHAT_ID=REPLACE_ME

# Live trading credentials must be separate from demo credentials.
# The AI trader also requires:
#   --environment live --execute --live-confirm I_UNDERSTAND_LIVE_RISK
# BINANCE_FUTURES_LIVE_API_KEY=REPLACE_ME
# BINANCE_FUTURES_LIVE_API_SECRET=REPLACE_ME
